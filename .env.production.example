# ESYNYC Lesson Search v2 - Production Environment TEMPLATE
# 
# ⚠️ This is a template showing recommended production configuration
# Copy to .env.production.local and fill in actual values
# Many features shown here may require additional setup

# ==========================================
# CORE SERVICES (Required)
# ==========================================

# Supabase Production Project
VITE_SUPABASE_URL=https://your-prod-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# ERROR TRACKING (Highly Recommended)
# ==========================================

# Sentry for Production Monitoring
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==========================================
# FEATURE FLAGS
# ==========================================

# Production Feature Configuration
# VITE_ENABLE_DOC_EMBED defaults ON in code; set to false to hide the Google Doc iframe on the review page
VITE_ENABLE_DOC_EMBED=true

# ==========================================
# EDGE FUNCTION SECRETS (Set in Supabase Dashboard)
# ==========================================

# These are NOT set in .env files but in Supabase Dashboard:
# - SUPABASE_SERVICE_ROLE_KEY
# - GOOGLE_SERVICE_ACCOUNT_JSON
# - GOOGLE_IMPERSONATE_EMAIL
# - RESEND_API_KEY
# - PUBLIC_SITE_URL=https://lessons.esynyc.org

# ==========================================
# SECURITY HEADERS (Set in hosting platform)
# ==========================================

# Content-Security-Policy
# X-Frame-Options: SAMEORIGIN
# X-Content-Type-Options: nosniff
# Referrer-Policy: strict-origin-when-cross-origin

# ==========================================
# PRODUCTION CHECKLIST
# ==========================================

# Before deploying to production:
# [ ] All API keys are production keys
# [ ] Sentry DSN is configured
# [ ] Edge function secrets are set in Supabase
# [ ] PUBLIC_SITE_URL matches production domain
# [ ] Feature flags are set appropriately
# [ ] Security headers are configured in hosting
# [ ] SSL certificate is valid
# [ ] Database backups are configured
# [ ] Monitoring alerts are set up
# [ ] Rate limiting is enabled
