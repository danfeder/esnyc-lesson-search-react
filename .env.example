# ESYNYC Lesson Search v2 Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration (Required)
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Required for data import/admin scripts)
# IMPORTANT: Never expose this in frontend code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sentry Error Tracking (Optional but recommended for production)
# Get your DSN from https://sentry.io
# Leave empty to disable error tracking
VITE_SENTRY_DSN=

# Edge Function Environment Variables
# These are set in Supabase dashboard, not in .env file

# Google Cloud Configuration (Optional - for Google Docs integration)
# Live: used by extract-google-doc + sync-drive-metadata (domain-wide delegation). Set in Supabase edge-function secrets, not here.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Email Service Configuration (Required for email notifications)
# Get this from Resend.com dashboard
# Set in Supabase edge function environment
# RESEND_API_KEY=re_...

# Public Site URL (Required for email links)
# Update this for production deployment
# Set in Supabase edge function environment
# PUBLIC_SITE_URL=https://app.esynyc.org

# CORS Configuration (Optional)
# Comma-separated list of allowed origins for edge functions
# Set in Supabase edge function environment
# ALLOWED_ORIGINS=http://localhost:5173,https://app.esynyc.org

# Feature Flags (Optional)
# Enable/disable features for testing and gradual rollout
# Default ON in code (src/utils/featureFlags.ts: enabled unless the value is exactly 'false'). Set to false to hide the Google Doc iframe on the review page.
# VITE_ENABLE_DOC_EMBED=true

# Development Notes:
# - Frontend variables must start with VITE_ to be accessible
# - Edge function variables are set in Supabase dashboard, not .env
# - Never commit real API keys to version control
# - Use different keys for development and production
