{
  "name": "esnyc-lesson-search-react",
  "version": "2.0.0",
  "type": "module",
  "description": "ESYNYC Lesson Library Search Interface - A searchable database of tagged Edible Schoolyard NYC lesson plans",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && npm run type-check:scripts",
    "type-check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "check": "npm run type-check && npm run lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "import-data": "node scripts/import-data.js",
    "export-dev-seed": "node scripts/export-dev-seed.mjs",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist",
    "test:lighthouse": "npm run build && lhci autorun",
    "analyze": "npm run build && npx vite-bundle-analyzer dist/",
    "test:rls": "node scripts/test-rls-policies.mjs",
    "test:heritage": "node scripts/heritage/test-heritage-expansion.mjs",
    "test:edge-functions": "node scripts/test-edge-functions.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:types:remote": "supabase gen types typescript --linked > src/types/database.types.ts",
    "db:reset": "supabase db reset --local",
    "db:push": "supabase db push --include-all",
    "eval:search": "npx tsx scripts/search-eval/run-search-eval.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "keywords": [
    "education",
    "lesson-plans",
    "search",
    "edible-schoolyard",
    "teaching-resources"
  ],
  "author": "ESNYC",
  "license": "MIT",
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@sentry/react": "^10.38.0",
    "@supabase/supabase-js": "^2.84.0",
    "@tanstack/react-query": "^5.101.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.563.0",
    "react": "^19.1.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.8.2",
    "react-select": "^5.10.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vite": "^7.2.7",
    "vite-bundle-analyzer": "^1.3.6",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
