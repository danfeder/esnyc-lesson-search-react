-- =====================================================
-- ROLLBACK: 20261026004805_repair_array_mirror_drift.sql
-- =====================================================
-- The .sql.rollback extension keeps this file inert under `supabase db push`
-- (the CLI only picks up .sql files). To roll back manually, run it as ONE
-- batch via psql or `mcp__supabase-*__execute_sql`.
--
-- Restores the drift BY DESIGN: resets the mirror of each of the 59 censused
-- (lesson, key) pairs (scripts/mirror-drift/census-2026-10-22.prod.json) back
-- to '[]'. Pairs the forward migration did not touch (row gone, column no
-- longer equal to the census value, or mirror already differing from the
-- column) are reported and skipped, never guessed at.
--
-- Refuses to run while the extended trigger
-- (20261026004447_normalize_trigger_sync_remaining_array_mirrors.sql) is
-- live — the next write would just re-sync the mirror. Run that migration's
-- .rollback first. updated_at is not touched (the forward migration did not
-- touch it either).
-- =====================================================

BEGIN;

LOCK TABLE public.lessons IN SHARE ROW EXCLUSIVE MODE;

-- Guard: the extended trigger must NOT be live.
DO $$
DECLARE
  v_src text;
BEGIN
  SELECT p.prosrc INTO v_src
  FROM pg_trigger t JOIN pg_proc p ON p.oid = t.tgfoid
  WHERE t.tgrelid = 'public.lessons'::regclass
    AND t.tgname = 'lessons_normalize_write_trg'
    AND t.tgenabled <> 'D';
  IF v_src IS NOT NULL AND strpos(v_src, 'jsonb_set(NEW.metadata, ''{observancesHolidays}''') > 0 THEN
    RAISE EXCEPTION 'ROLLBACK GUARD: lessons_normalize_write still contains sections (L)-(P); roll back 20261026004447 first or the mirrors are re-synced on the next write';
  END IF;
END $$;

