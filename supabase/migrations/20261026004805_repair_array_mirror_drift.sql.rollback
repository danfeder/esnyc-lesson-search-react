DO $$
DECLARE
  v_n bigint;
BEGIN
  SELECT count(*) INTO v_n FROM _mirror_rollback_list;
  IF v_n <> 59 OR (SELECT count(DISTINCT lesson_id) FROM _mirror_rollback_list) <> 45 THEN
    RAISE EXCEPTION 'ROLLBACK GUARD: allowlist is % pairs (expected 59 on 45 lessons)', v_n;
  END IF;
END $$;

-- Eligible = row exists, live column still set-equals the census value, and
-- the mirror currently equals the column (i.e. the forward repair's result).
CREATE TEMP TABLE _mirror_rollback_eligible ON COMMIT DROP AS
SELECT r.lesson_id, r.key
FROM _mirror_rollback_list r
JOIN public.lessons l ON l.lesson_id = r.lesson_id
CROSS JOIN LATERAL (
  SELECT CASE r.key
    WHEN 'observancesHolidays'            THEN l.observances_holidays
    WHEN 'mainIngredients'                THEN l.main_ingredients
    WHEN 'gardenSkills'                   THEN l.garden_skills
    WHEN 'cookingSkills'                  THEN l.cooking_skills
    WHEN 'culturalResponsivenessFeatures' THEN l.cultural_responsiveness_features
  END AS col
) c
WHERE c.col @> r.census_col AND c.col <@ r.census_col
  AND public._meta_array_matches_column(l.metadata->r.key, c.col);

DO $$
DECLARE
  r record;
BEGIN
  FOR r IN
    SELECT l.lesson_id, l.key
    FROM _mirror_rollback_list l
    LEFT JOIN _mirror_rollback_eligible e USING (lesson_id, key)
    WHERE e.lesson_id IS NULL
    ORDER BY 1, 2
  LOOP
    RAISE NOTICE 'mirror rollback: skipping %:% (row missing, column moved, or mirror not equal to column)', r.lesson_id, r.key;
  END LOOP;
  RAISE NOTICE 'mirror rollback: resetting % pair(s) to []', (SELECT count(*) FROM _mirror_rollback_eligible);
END $$;

UPDATE public.lessons l
SET metadata = l.metadata || d.patch
FROM (
  SELECT lesson_id, jsonb_object_agg(key, '[]'::jsonb) AS patch
  FROM _mirror_rollback_eligible
  GROUP BY lesson_id
) d
WHERE l.lesson_id = d.lesson_id;

DO $$
DECLARE
  v_bad bigint;
BEGIN
  SELECT count(*) INTO v_bad
  FROM _mirror_rollback_eligible e
  JOIN public.lessons l ON l.lesson_id = e.lesson_id
  WHERE l.metadata->e.key IS DISTINCT FROM '[]'::jsonb;
  IF v_bad > 0 THEN
    RAISE EXCEPTION 'ROLLBACK POST-ASSERT FAILED: % mirror(s) not reset to []', v_bad;
  END IF;
END $$;

COMMIT;
